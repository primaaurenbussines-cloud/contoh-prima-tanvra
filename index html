.prima-new-screen .batik-orbit,.prima-new-screen .prima-scan-new,.prima-videotron .prima-scan,.prima-videotron-label,.prima-videotron-status,.prima-videotron-copy,.prima-videotron-sub{display:none!important;}
.prima-logo-image-lockup{width:min(30%,330px)!important;z-index:10!important;}
@media(max-width:800px){.prima-logo-image-lockup{width:min(52%,300px)!important;}}

.prima-logo-image-lockup{
  overflow:visible;
  animation:primaCalmGlow 12s ease-in-out infinite !important;
}
.prima-logo-image-lockup img{
  clip-path:inset(100% 0 0 0);
  animation:primaCalmReveal 12s cubic-bezier(.55,0,.35,1) infinite !important;
  will-change:clip-path,opacity,filter;
}
.prima-logo-image-lockup::before{
  content:"";
  position:absolute;
  left:-10%; right:-10%;
  top:0;
  height:2px;
  z-index:3;
  pointer-events:none;
  background:rgba(244,195,99,.95);
  box-shadow:0 0 8px rgba(244,195,99,.65),0 0 18px rgba(244,195,99,.25);
  opacity:0;
  animation:primaCalmScanLine 12s cubic-bezier(.55,0,.35,1) infinite;
}
.prima-logo-image-lockup::after{display:none!important;}
@keyframes primaCalmReveal{
  0%,8%{clip-path:inset(100% 0 0 0);opacity:0;filter:brightness(.65) blur(1.5px)}
  12%{opacity:1}
  72%{clip-path:inset(0 0 0 0);opacity:1;filter:brightness(1) blur(0)}
  84%{clip-path:inset(0 0 0 0);opacity:1}
  100%{clip-path:inset(0 0 0 0);opacity:0;filter:brightness(.8)}
}
@keyframes primaCalmScanLine{
  0%,8%{top:100%;opacity:0}
  12%{top:100%;opacity:1}
  72%{top:0%;opacity:.9}
  78%{top:0%;opacity:0}
  100%{top:100%;opacity:0}
}
@keyframes primaCalmGlow{
  0%,8%{filter:drop-shadow(0 0 0 rgba(235,181,76,0))}
  18%,78%{filter:drop-shadow(0 0 12px rgba(235,181,76,.16))}
  86%,100%{filter:drop-shadow(0 0 0 rgba(235,181,76,0))}
}

.prima-logo-image-lockup{
  animation: primaFinalGlow 15s ease-in-out infinite !important;
}
.prima-logo-image-lockup img{
  clip-path: inset(0 0 100% 0);
  animation: primaFinalReveal 15s cubic-bezier(.42,0,.28,1) infinite !important;
  will-change: clip-path, opacity, filter;
}
.prima-logo-image-lockup::before{
  content:"";
  position:absolute;
  left:-12%; right:-12%;
  top:0;
  height:2px;
  z-index:12;
  pointer-events:none;
  background:linear-gradient(90deg,transparent,rgba(255,221,150,.95) 50%,transparent);
  box-shadow:0 0 7px rgba(255,210,120,.72),0 0 20px rgba(255,195,90,.25);
  opacity:0;
  animation: primaFinalScan 15s cubic-bezier(.42,0,.28,1) infinite;
}
@keyframes primaFinalReveal{
  0%,10%{clip-path:inset(0 0 100% 0);opacity:0;filter:brightness(.42) blur(2px)}
  16%{opacity:.28;filter:brightness(.65) blur(1.4px)}
  28%{clip-path:inset(0 0 76% 0);opacity:.48;filter:brightness(.78) blur(.9px)}
  43%{clip-path:inset(0 0 52% 0);opacity:.68;filter:brightness(.88) blur(.5px)}
  58%{clip-path:inset(0 0 28% 0);opacity:.84;filter:brightness(.96) blur(.2px)}
  72%{clip-path:inset(0 0 0 0);opacity:.96;filter:brightness(1) blur(0)}
  84%{clip-path:inset(0 0 0 0);opacity:1;filter:brightness(1.08) blur(0)}
  91%{clip-path:inset(0 0 0 0);opacity:1;filter:brightness(1.16) blur(0)}
  100%{clip-path:inset(0 0 100% 0);opacity:0;filter:brightness(.72) blur(1px)}
}
@keyframes primaFinalScan{
  0%,10%{top:0;opacity:0}
  14%{top:0;opacity:.9}
  28%{top:24%;opacity:.85}
  43%{top:48%;opacity:.78}
  58%{top:72%;opacity:.7}
  72%{top:100%;opacity:.45}
  76%{top:100%;opacity:0}
  100%{top:0;opacity:0}
}
@keyframes primaFinalGlow{
  0%,10%{filter:drop-shadow(0 0 0 rgba(235,181,76,0))}
  28%{filter:drop-shadow(0 0 7px rgba(235,181,76,.10))}
  58%{filter:drop-shadow(0 0 12px rgba(235,181,76,.16))}
  72%,91%{filter:drop-shadow(0 0 18px rgba(235,181,76,.23))}
  100%{filter:drop-shadow(0 0 0 rgba(235,181,76,0))}
}

.prima-photo-videotron{
  position:relative!important;
  width:100%!important;
  max-width:1120px!important;
  margin:0 auto!important;
  min-height:0!important;
  aspect-ratio:16/9!important;
  overflow:hidden!important;
  border:1px solid rgba(210,170,105,.45)!important;
  border-radius:12px!important;
  background:#050505!important;
  box-shadow:0 22px 55px rgba(20,12,8,.28)!important;
}
.prima-photo-screen{
  position:absolute;
  inset:0;
  overflow:hidden;
  background:#050505;
}
.prima-photo-videotron-img{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center center;
  display:block;
  opacity:0;
  transform:scale(1.02);
  filter:brightness(.72) contrast(1.08) saturate(.92);
  animation:primaPhotoBillboard 14s ease-in-out infinite;
  will-change:transform,opacity,filter;
}
.prima-photo-vignette{
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    linear-gradient(90deg,rgba(0,0,0,.34),transparent 22%,transparent 78%,rgba(0,0,0,.34)),
    linear-gradient(180deg,rgba(0,0,0,.16),transparent 25%,transparent 76%,rgba(0,0,0,.30));
  box-shadow:inset 0 0 85px rgba(0,0,0,.45);
  z-index:2;
}
.prima-photo-sweep{
  position:absolute;
  top:-20%;
  bottom:-20%;
  left:-38%;
  width:18%;
  z-index:3;
  pointer-events:none;
  opacity:0;
  transform:skewX(-18deg);
  background:linear-gradient(90deg,transparent,rgba(255,220,150,.18),rgba(255,231,181,.42),rgba(255,220,150,.12),transparent);
  filter:blur(2px);
  animation:primaPhotoSweep 14s ease-in-out infinite;
}
.prima-photo-glow{
  position:absolute;
  inset:0;
  z-index:4;
  pointer-events:none;
  opacity:0;
  background:radial-gradient(circle at 50% 50%,rgba(246,195,104,.12),transparent 48%);
  animation:primaPhotoGlow 14s ease-in-out infinite;
}
@keyframes primaPhotoBillboard{
  0%{opacity:0;transform:scale(1.045) translate3d(-.7%,0,0);filter:brightness(.48) contrast(1.12) saturate(.78);}
  9%{opacity:1;}
  24%{transform:scale(1.015) translate3d(.4%,-.2%,0);filter:brightness(.78) contrast(1.1) saturate(.9);}
  48%{transform:scale(1.055) translate3d(-.5%,.15%,0);filter:brightness(.9) contrast(1.08) saturate(.96);}
  72%{opacity:1;transform:scale(1.02) translate3d(.5%,0,0);filter:brightness(.82) contrast(1.1) saturate(.95);}
  91%{opacity:.96;transform:scale(1.045) translate3d(-.2%,0,0);filter:brightness(.72) contrast(1.1) saturate(.9);}
  100%{opacity:0;transform:scale(1.055) translate3d(.2%,0,0);filter:brightness(.45) contrast(1.12) saturate(.78);}
}
@keyframes primaPhotoSweep{
  0%,24%{left:-38%;opacity:0;}
  31%{opacity:.85;}
  46%{left:120%;opacity:.65;}
  52%,100%{left:120%;opacity:0;}
}
@keyframes primaPhotoGlow{
  0%,25%{opacity:0;}
  36%,52%{opacity:.9;}
  64%,100%{opacity:0;}
}
@media(max-width:800px){
  .prima-photo-videotron{
    aspect-ratio:16/9!important;
    border-radius:10px!important;
  }
}
@media(prefers-reduced-motion:reduce){
  .prima-photo-videotron-img,.prima-photo-sweep,.prima-photo-glow{animation:none!important;}
  .prima-photo-videotron-img{opacity:1!important;transform:none!important;filter:none!important;}
}

