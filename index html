<script id="prima-js-cinematic-motion">
(function(){
  function start(){
    var img=document.querySelector('.prima-master-videotron-img');
    if(!img || img.__primaMotionStarted) return;
    img.__primaMotionStarted=true;
    var startTime=performance.now();
    var duration=10000;
    function frame(now){
      var t=((now-startTime)%duration)/duration;
      var eased=(1-Math.cos(t*Math.PI*2))/2;
      var scale=1.0 + 0.038*eased;
      var x=-0.22*eased;
      var y=0.12*eased;
      var brightness=0.965 + 0.035*eased;
      img.style.setProperty('transform','scale('+scale.toFixed(5)+') translate3d('+x.toFixed(3)+'%,'+y.toFixed(3)+'%,0)','important');
      img.style.setProperty('filter','brightness('+brightness.toFixed(3)+') contrast(1.045) saturate(.99)','important');
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',start,{once:true});
  else start();
})();
</script>
